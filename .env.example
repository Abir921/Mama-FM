# Discord bot token (Discord Developer Portal -> Bot -> Token)
DISCORD_TOKEN=

# Optional: your server's ID. If set, commands sync instantly to that guild.
# If empty, commands sync globally (can take up to ~1 hour to appear).
GUILD_ID=

# Lavalink server (music). Defaults match the bundled lavalink/application.yml.
LAVALINK_URI=http://127.0.0.1:2333
LAVALINK_PASSWORD=youshallnotpass

# Minutes the bot waits alone in a voice channel before auto-disconnecting.
VOICE_IDLE_MINUTES=5

# Where /mama play searches: youtube | youtubemusic | soundcloud
# YouTube often refuses anonymous audio extraction ("This video requires login"),
# so soundcloud is the default that plays without any auth setup.
MUSIC_SOURCE=soundcloud

# Retry a failed track on SoundCloud automatically (1 = on, 0 = off)
MUSIC_FALLBACK=1

# HenrikDev API key for Valorant stats (https://docs.henrikdev.xyz -> get a key)
HENRIK_API_KEY=
